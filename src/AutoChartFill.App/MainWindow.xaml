<Window x:Class="AutoChartFill.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Chart Fill" Width="1080" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F3F5F6">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="36"/></Grid.RowDefinitions>

        <Border Background="#243137" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AUTO CHART FILL" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <TextBlock Text="Game bridge" Foreground="#AFC0C7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding BridgeText}" Foreground="#78D7B2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Capture" IsChecked="{Binding Settings.CaptureEnabled, Mode=TwoWay}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" Checked="CaptureChanged" Unchecked="CaptureChanged"/>
                    <Button Content="Retry" Click="Retry_Click" IsEnabled="{Binding HasPendingRender}"/>
                    <Button Content="Find Relay" Click="FindRelay_Click"/>
                    <Button Content="Reset tracking" Click="Reset_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="470"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*" MinWidth="300"/></Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Highlighted difficulty" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Chart ID" Margin="0,7"/><TextBlock Grid.Column="1" Text="{Binding CurrentChart.ChartId}" FontWeight="SemiBold" Margin="0,7" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Song" Margin="0,7"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentSong}" FontWeight="SemiBold" Margin="0,7" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Difficulty" Margin="0,7"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentDifficulty}" FontWeight="SemiBold" Margin="0,7"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Charter" Margin="0,7"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentCharter}" Margin="0,7" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Tech stats" Margin="0,7"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentStats}" Margin="0,7" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="Waiting for a highlighted difficulty from vivid/stasis." Foreground="#78858B" VerticalAlignment="Bottom" Margin="0,24,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Workbook" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Selected file"/><TextBlock Text="{Binding Settings.Workbook.WorkbookPath}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource Label}" Text="Tracking"/><TextBlock Text="{Binding CapturedCount, StringFormat={}{0} captured rows}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource Label}" Text="Write state"/><TextBlock Text="{Binding PendingText}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Workbook status" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding WorkbookStatus}" TextWrapping="Wrap" Foreground="#58656B"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Expander Grid.Row="2" Header="Workbook, game bridge, and color configuration" Margin="16,0,16,12" IsExpanded="False">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="330">
                    <StackPanel>
                        <TextBlock Text="Workbook destination" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12" IsEnabled="{Binding IsConfigurationEnabled}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.Workbook.WorkbookPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseWorkbook_Click"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Worksheets}" Text="{Binding Settings.Workbook.WorksheetName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,8,0" ToolTip="Worksheet"/>
                            <TextBox Grid.Column="3" Text="{Binding Settings.Workbook.FirstDataRow, UpdateSourceTrigger=PropertyChanged}" ToolTip="Prototype / first data row"/>
                        </Grid>

                        <TextBlock Text="Column mapping" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,10" IsEnabled="{Binding IsConfigurationEnabled}">
                            <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Jacket"/><TextBox Text="{Binding Settings.Workbook.Columns.Jacket}"/></StackPanel>
                            <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Title - Artist"/><TextBox Text="{Binding Settings.Workbook.Columns.Song}"/></StackPanel>
                            <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Difficulty"/><TextBox Text="{Binding Settings.Workbook.Columns.Difficulty}"/></StackPanel>
                            <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Level"/><TextBox Text="{Binding Settings.Workbook.Columns.Level}"/></StackPanel>
                            <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Charter"/><TextBox Text="{Binding Settings.Workbook.Columns.Charter}"/></StackPanel>
                            <StackPanel Width="70" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="CHIP"/><TextBox Text="{Binding Settings.Workbook.Columns.Chip}"/></StackPanel>
                            <StackPanel Width="70" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="TECH"/><TextBox Text="{Binding Settings.Workbook.Columns.Tech}"/></StackPanel>
                            <StackPanel Width="70" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="STREAM"/><TextBox Text="{Binding Settings.Workbook.Columns.Stream}"/></StackPanel>
                            <StackPanel Width="70" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="CHORD"/><TextBox Text="{Binding Settings.Workbook.Columns.Chord}"/></StackPanel>
                            <StackPanel Width="70" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="BURST"/><TextBox Text="{Binding Settings.Workbook.Columns.Burst}"/></StackPanel>
                            <StackPanel Width="80" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="GIMMICK"/><TextBox Text="{Binding Settings.Workbook.Columns.Gimmick}"/></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="Difficulty colors" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="OPN"/><DockPanel><Button Content="Pick" Tag="OPN" Click="PickColor_Click" Padding="8,4"/><TextBox Text="{Binding Settings.Workbook.Colors.Opn}"/></DockPanel></StackPanel>
                            <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="MID"/><DockPanel><Button Content="Pick" Tag="MID" Click="PickColor_Click" Padding="8,4"/><TextBox Text="{Binding Settings.Workbook.Colors.Mid}"/></DockPanel></StackPanel>
                            <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="FIN"/><DockPanel><Button Content="Pick" Tag="FIN" Click="PickColor_Click" Padding="8,4"/><TextBox Text="{Binding Settings.Workbook.Colors.Fin}"/></DockPanel></StackPanel>
                            <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="ENC"/><DockPanel><Button Content="Pick" Tag="ENC" Click="PickColor_Click" Padding="8,4"/><TextBox Text="{Binding Settings.Workbook.Colors.Enc}"/></DockPanel></StackPanel>
                            <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="BKS"/><DockPanel><Button Content="Pick" Tag="BKS" Click="PickColor_Click" Padding="8,4"/><TextBox Text="{Binding Settings.Workbook.Colors.Bks}"/></DockPanel></StackPanel>
                            <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="SHATTER"/><DockPanel><Button Content="Pick" Tag="SHATTER" Click="PickColor_Click" Padding="8,4"/><TextBox Text="{Binding Settings.Workbook.Colors.Shatter}"/></DockPanel></StackPanel>
                        </WrapPanel>

                        <WrapPanel>
                            <StackPanel Width="350" Margin="0,0,12,8"><TextBlock Style="{StaticResource Label}" Text="Game path"/><TextBox Text="{Binding Settings.GamePath}"/></StackPanel>
                            <Button Content="Save configuration" Click="SaveSettings_Click" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Expander>

        <Border Grid.Row="3" Background="#E3E7E9" Padding="12,8"><TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/></Border>
    </Grid>
</Window>
