<Application x:Class="AutoChartFill.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Border" Color="#D5DBDF" />
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="34"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="32"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#667078"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    </Application.Resources>
</Application>
